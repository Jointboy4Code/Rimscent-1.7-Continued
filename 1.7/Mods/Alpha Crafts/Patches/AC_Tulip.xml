<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="AC_Tulip"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="AC_Tulip"]/modExtensions</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="AC_Tulip"]</xpath>
            <value>
              <modExtensions />
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="AC_Tulip"]/modExtensions/li[@Class="RimScentReworked.ModExtension_Scent"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="AC_Tulip"]/modExtensions</xpath>
            <value>
              <li Class="RimScentReworked.ModExtension_Scent">
                <thought>RimScent_FloweryScent</thought>
              </li>
            </value>
          </nomatch>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>